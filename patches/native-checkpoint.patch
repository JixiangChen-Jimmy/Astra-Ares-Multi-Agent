diff --git a/codex-rs/core/src/tools/handlers/task_router.rs b/codex-rs/core/src/tools/handlers/task_router.rs
new file mode 100644
index 0000000..10ffe79
--- /dev/null
+++ b/codex-rs/core/src/tools/handlers/task_router.rs
@@ -0,0 +1,233 @@
+use crate::agent::api::SpawnPreStartHook;
+use crate::codex_thread::ThreadConfigSnapshot;
+use codex_protocol::ThreadId;
+use codex_protocol::error::CodexErr;
+use codex_protocol::openai_models::ReasoningEffort;
+use futures::future::BoxFuture;
+use serde::Deserialize;
+use serde::Serialize;
+use serde_json::Value;
+use serde_json::json;
+use std::path::PathBuf;
+use std::time::Duration;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::net::UnixStream;
+use tokio::time::timeout;
+use uuid::Uuid;
+
+const MAX_FRAME_BYTES: usize = 16 * 1024;
+
+#[derive(Debug, Deserialize, Serialize)]
+#[serde(deny_unknown_fields)]
+pub(crate) struct TaskRoute {
+    pub(crate) kind: String,
+    pub(crate) description: String,
+    pub(crate) failure_count: u32,
+    pub(crate) uncertainty: String,
+    pub(crate) scope: String,
+    pub(crate) effects_known: bool,
+    pub(crate) data_class: String,
+}
+
+impl TaskRoute {
+    fn validate(&self) -> Result<(), String> {
+        if !matches!(
+            self.kind.as_str(),
+            "core_implementation"
+                | "simple_code"
+                | "execution"
+                | "review"
+                | "review_core"
+                | "research"
+        ) {
+            return Err("task_route.kind is unsupported".to_string());
+        }
+        if self.description.trim().is_empty()
+            || self.description.chars().count() > 400
+            || self.description.chars().any(char::is_control)
+            || self.description.contains("```")
+        {
+            return Err(
+                "task_route.description must be one line of 1-400 printable characters".to_string(),
+            );
+        }
+        if self.failure_count > 100 {
+            return Err("task_route.failure_count must be at most 100".to_string());
+        }
+        if !matches!(self.uncertainty.as_str(), "low" | "moderate" | "high") {
+            return Err("task_route.uncertainty must be low, moderate, or high".to_string());
+        }
+        if !matches!(self.scope.as_str(), "local" | "cross_module" | "core") {
+            return Err("task_route.scope must be local, cross_module, or core".to_string());
+        }
+        if !matches!(self.data_class.as_str(), "public" | "synthetic") {
+            return Err("task_route.data_class must be public or synthetic".to_string());
+        }
+        Ok(())
+    }
+}
+
+#[derive(Debug, Deserialize)]
+#[serde(rename_all = "camelCase")]
+struct RouteDecision {
+    protocol: u8,
+    #[serde(rename = "type")]
+    message_type: String,
+    route_id: String,
+    model: String,
+    effort: ReasoningEffort,
+    role: String,
+    source: String,
+    reason: String,
+}
+
+#[derive(Clone)]
+pub(crate) struct PendingRoute {
+    socket: PathBuf,
+    route_id: String,
+    parent_thread_id: ThreadId,
+    pub(crate) model: String,
+    pub(crate) effort: ReasoningEffort,
+    pub(crate) role: String,
+}
+
+pub(crate) fn enabled() -> bool {
+    std::env::var_os("CODEX_TASK_ROUTER_SOCKET").is_some()
+}
+
+pub(crate) async fn route(
+    task: Option<TaskRoute>,
+    parent_thread_id: ThreadId,
+    requested_role: &str,
+) -> Result<Option<PendingRoute>, String> {
+    let Some(socket) = std::env::var_os("CODEX_TASK_ROUTER_SOCKET") else {
+        return Ok(None);
+    };
+    let task = task.ok_or("task_route is required for project agent spawning")?;
+    task.validate()?;
+    let socket = PathBuf::from(socket);
+    let route_id = Uuid::new_v4().to_string();
+    let request = json!({
+        "protocol": 1,
+        "type": "route",
+        "routeId": route_id,
+        "parentThreadId": parent_thread_id.to_string(),
+        "task": task,
+        "requestedRole": requested_role,
+    });
+    let response = exchange(&socket, &request).await?;
+    let decision: RouteDecision = serde_json::from_value(response)
+        .map_err(|error| format!("task router returned invalid decision: {error}"))?;
+    if decision.protocol != 1
+        || decision.message_type != "route_decision"
+        || decision.route_id != route_id
+        || decision.model.trim().is_empty()
+        || !matches!(
+            decision.role.as_str(),
+            "worker"
+                | "reviewer"
+                | "reviewer_core"
+                | "researcher"
+                | "simple_worker"
+                | "executor"
+                | "luna_worker"
+                | "luna_executor"
+        )
+        || decision.source.trim().is_empty()
+        || decision.reason.trim().is_empty()
+    {
+        return Err("task router returned mismatched or incomplete decision".to_string());
+    }
+    Ok(Some(PendingRoute {
+        socket,
+        route_id,
+        parent_thread_id,
+        model: decision.model,
+        effort: decision.effort,
+        role: decision.role,
+    }))
+}
+
+impl PendingRoute {
+    pub(crate) fn pre_start_hook(self) -> SpawnPreStartHook {
+        Box::new(move |child_thread_id, snapshot| {
+            Box::pin(async move {
+                self.acknowledge(child_thread_id, &snapshot)
+                    .await
+                    .map_err(CodexErr::InvalidRequest)
+            }) as BoxFuture<'static, codex_protocol::error::Result<()>>
+        })
+    }
+
+    pub(crate) async fn acknowledge(
+        &self,
+        child_thread_id: ThreadId,
+        snapshot: &ThreadConfigSnapshot,
+    ) -> Result<(), String> {
+        if snapshot.model != self.model || snapshot.reasoning_effort.as_ref() != Some(&self.effort)
+        {
+            return Err(format!(
+                "child settings differ from route decision: model={}, effort={:?}",
+                snapshot.model, snapshot.reasoning_effort
+            ));
+        }
+        let request = json!({
+            "protocol": 1,
+            "type": "route_applied",
+            "routeId": self.route_id,
+            "parentThreadId": self.parent_thread_id.to_string(),
+            "childThreadId": child_thread_id.to_string(),
+            "model": snapshot.model,
+            "effort": self.effort.as_str(),
+            "confirmation": "native_child_context_captured",
+        });
+        let response = exchange(&self.socket, &request).await?;
+        if response.get("protocol") != Some(&Value::from(1))
+            || response.get("type") != Some(&Value::from("route_applied_ack"))
+            || response.get("routeId") != Some(&Value::from(self.route_id.as_str()))
+        {
+            return Err("task router did not acknowledge applied settings".to_string());
+        }
+        Ok(())
+    }
+}
+
+async fn exchange(socket: &PathBuf, message: &Value) -> Result<Value, String> {
+    timeout(Duration::from_secs(60), async {
+        let mut stream = UnixStream::connect(socket)
+            .await
+            .map_err(|error| format!("task router connect failed: {error}"))?;
+        let payload = serde_json::to_vec(message)
+            .map_err(|error| format!("task router request failed: {error}"))?;
+        if payload.len() > MAX_FRAME_BYTES {
+            return Err("task router request exceeds frame limit".to_string());
+        }
+        stream
+            .write_all(&(payload.len() as u32).to_be_bytes())
+            .await
+            .map_err(|error| format!("task router write failed: {error}"))?;
+        stream
+            .write_all(&payload)
+            .await
+            .map_err(|error| format!("task router write failed: {error}"))?;
+        let mut length = [0_u8; 4];
+        stream
+            .read_exact(&mut length)
+            .await
+            .map_err(|error| format!("task router read failed: {error}"))?;
+        let length = u32::from_be_bytes(length) as usize;
+        if length == 0 || length > MAX_FRAME_BYTES {
+            return Err("task router response has invalid frame length".to_string());
+        }
+        let mut payload = vec![0_u8; length];
+        stream
+            .read_exact(&mut payload)
+            .await
+            .map_err(|error| format!("task router read failed: {error}"))?;
+        serde_json::from_slice(&payload)
+            .map_err(|error| format!("task router response is invalid JSON: {error}"))
+    })
+    .await
+    .map_err(|_| "task router timed out".to_string())?
+}
