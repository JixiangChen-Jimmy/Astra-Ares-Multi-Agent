diff --git a/codex-rs/core/src/session/decision_context.rs b/codex-rs/core/src/session/decision_context.rs
new file mode 100644
index 0000000..5246c52
--- /dev/null
+++ b/codex-rs/core/src/session/decision_context.rs
@@ -0,0 +1,193 @@
+//! Text visible to a supervisor: user input, published commentary/summaries, and
+//! paired recent tools. Opaque reasoning and media never enter this projection.
+
+use std::collections::HashMap;
+
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::models::ContentItem;
+use codex_protocol::models::MessagePhase;
+use codex_protocol::models::ReasoningItemReasoningSummary;
+use codex_protocol::models::ResponseItem;
+use serde::Serialize;
+
+use crate::context_manager::is_user_turn_boundary;
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+pub(super) struct DecisionContext {
+    schema: &'static str,
+    scope: &'static str,
+    original_turn_prompt: String,
+    latest_user_prompt: String,
+    prior_user_prompts: Vec<String>,
+    public_notes: Vec<PublicNote>,
+    recent_tool_calls: Vec<ToolExchange>,
+    omitted_older_tool_calls: usize,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct PublicNote {
+    history_index: usize,
+    kind: &'static str,
+    phase: Option<MessagePhase>,
+    text: String,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct ToolExchange {
+    history_index: usize,
+    call_id: String,
+    name: String,
+    namespace: Option<String>,
+    input: String,
+    outputs: Vec<ToolResult>,
+}
+
+#[derive(Serialize)]
+#[serde(rename_all = "camelCase")]
+struct ToolResult {
+    history_index: usize,
+    text: Option<String>,
+    success: Option<bool>,
+    native_token_limit: Option<usize>,
+}
+
+pub(super) fn decision_context(
+    items: &[ResponseItemEnvelope],
+    original_turn_prompt: &str,
+    latest_user_prompt: &str,
+) -> DecisionContext {
+    let mut calls = Vec::new();
+    let mut public_notes = Vec::new();
+    let mut prior_user_prompts = Vec::new();
+    for (index, envelope) in items.iter().enumerate() {
+        match &envelope.item {
+            ResponseItem::Message {
+                role,
+                content,
+                phase,
+                ..
+            } if role == "assistant" || role == "user" => {
+                let text = content
+                    .iter()
+                    .filter_map(|part| match part {
+                        ContentItem::InputText { text } | ContentItem::OutputText { text } => {
+                            Some(text.as_str())
+                        }
+                        ContentItem::InputImage { .. } | ContentItem::InputAudio { .. } => None,
+                    })
+                    .collect::<Vec<_>>()
+                    .join("\n");
+                if role == "assistant" && !text.is_empty() {
+                    public_notes.push(PublicNote {
+                        history_index: index,
+                        kind: "assistant_message",
+                        phase: phase.clone(),
+                        text,
+                    });
+                } else if role == "user"
+                    && is_user_turn_boundary(&envelope.item)
+                    && text != latest_user_prompt
+                    && text != original_turn_prompt
+                    && !text.is_empty()
+                {
+                    prior_user_prompts.push(text);
+                }
+            }
+            ResponseItem::Reasoning { summary, .. } => {
+                let text = summary
+                    .iter()
+                    .map(|part| match part {
+                        ReasoningItemReasoningSummary::SummaryText { text } => text.as_str(),
+                    })
+                    .collect::<Vec<_>>()
+                    .join("\n");
+                if !text.is_empty() {
+                    public_notes.push(PublicNote {
+                        history_index: index,
+                        kind: "reasoning_summary",
+                        phase: None,
+                        text,
+                    });
+                }
+            }
+            ResponseItem::FunctionCall { .. } | ResponseItem::CustomToolCall { .. } => {
+                calls.push(index)
+            }
+            _ => {}
+        }
+    }
+    let omitted_older_tool_calls = calls.len().saturating_sub(6);
+    let mut recent_tool_calls = calls
+        .into_iter()
+        .skip(omitted_older_tool_calls)
+        .map(|index| {
+            let (call_id, name, namespace, input) = match &items[index].item {
+                ResponseItem::FunctionCall {
+                    call_id,
+                    name,
+                    namespace,
+                    arguments,
+                    ..
+                } => (call_id, name, namespace, arguments),
+                ResponseItem::CustomToolCall {
+                    call_id,
+                    name,
+                    namespace,
+                    input,
+                    ..
+                } => (call_id, name, namespace, input),
+                _ => unreachable!("selected a non-tool history item"),
+            };
+            ToolExchange {
+                history_index: index,
+                call_id: call_id.clone(),
+                name: name.clone(),
+                namespace: namespace.clone(),
+                input: input.clone(),
+                outputs: Vec::new(),
+            }
+        })
+        .collect::<Vec<_>>();
+    let positions = recent_tool_calls
+        .iter()
+        .enumerate()
+        .map(|(index, call)| (call.call_id.clone(), index))
+        .collect::<HashMap<_, _>>();
+    for (index, envelope) in items.iter().enumerate() {
+        let (call_id, output) = match &envelope.item {
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id),
+                output,
+                ..
+            }
+            | ResponseItem::CustomToolCallOutput {
+                call_id, output, ..
+            } => (call_id, output),
+            _ => continue,
+        };
+        if let Some(&position) = positions.get(call_id) {
+            recent_tool_calls[position].outputs.push(ToolResult {
+                history_index: index,
+                text: output.body.to_text(),
+                success: output.success,
+                native_token_limit: envelope
+                    .metadata
+                    .as_ref()
+                    .and_then(|metadata| metadata.history_truncation_token_limit),
+            });
+        }
+    }
+    DecisionContext {
+        schema: "CODEX_STEP_CONTROLLER_CONTEXT_V3",
+        scope: "native_retained_history",
+        original_turn_prompt: original_turn_prompt.to_owned(),
+        latest_user_prompt: latest_user_prompt.to_owned(),
+        prior_user_prompts,
+        public_notes,
+        recent_tool_calls,
+        omitted_older_tool_calls,
+    }
+}
