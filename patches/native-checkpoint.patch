+#[tokio::test]
+async fn cancelled_pre_start_ack_closes_child_before_input() {
+    let harness = AgentControlHarness::new().await;
+    let (parent_thread_id, _) = harness.start_thread().await;
+    let (captured_tx, captured_rx) = tokio::sync::oneshot::channel();
+    let (_release_tx, release_rx) = tokio::sync::oneshot::channel::<()>();
+    let control = harness.control.clone();
+    let config = harness.config.clone();
+    let task = tokio::spawn(async move {
+        control
+            .spawn(SpawnRequest {
+                caller: parent_thread_id,
+                config,
+                input: AgentInput::UserInput(text_input("must not run")),
+                source: SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                    parent_thread_id,
+                    depth: 1,
+                    agent_path: None,
+                    agent_nickname: None,
+                    agent_role: None,
+                }),
+                options: SpawnAgentOptions {
+                    parent_thread_id: Some(parent_thread_id),
+                    ..Default::default()
+                },
+                pre_start_hook: Some(Box::new(move |child_thread_id, _snapshot| {
+                    let _ = captured_tx.send(child_thread_id);
+                    Box::pin(async move {
+                        let _ = release_rx.await;
+                        Ok(())
+                    })
+                })),
+            })
+            .await
+    });
+    let child_thread_id = timeout(Duration::from_secs(5), captured_rx)
+        .await
+        .expect("child should reach pre-start hook")
+        .expect("child id should be captured");
+    task.abort();
+    assert!(task.await.is_err());
+    timeout(Duration::from_secs(5), async {
+        while harness.manager.get_thread(child_thread_id).await.is_ok() {
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("cancelled spawn child should be removed");
+    assert!(
+        !harness
+            .manager
+            .captured_ops()
+            .into_iter()
+            .any(|(thread_id, op)| {
+                thread_id == child_thread_id && matches!(op, Op::TurnInput { .. })
+            })
+    );
+}
