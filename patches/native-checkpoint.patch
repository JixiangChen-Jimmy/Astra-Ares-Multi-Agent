+#[tokio::test]
+async fn failed_pre_start_ack_closes_child_before_input() {
+    let harness = AgentControlHarness::new().await;
+    let (parent_thread_id, _) = harness.start_thread().await;
+    let (captured_tx, captured_rx) = tokio::sync::oneshot::channel();
+    let result = harness
+        .control
+        .spawn(SpawnRequest {
+            caller: parent_thread_id,
+            config: harness.config.clone(),
+            input: AgentInput::UserInput(text_input("must not run")),
+            source: SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+                parent_thread_id,
+                depth: 1,
+                agent_path: None,
+                agent_nickname: None,
+                agent_role: None,
+            }),
+            options: SpawnAgentOptions {
+                parent_thread_id: Some(parent_thread_id),
+                ..Default::default()
+            },
+            pre_start_hook: Some(Box::new(move |child_thread_id, snapshot| {
+                let _ = captured_tx.send((child_thread_id, snapshot.model));
+                Box::pin(async {
+                    Err(codex_protocol::error::CodexErr::InvalidRequest(
+                        "router ack failed".to_string(),
+                    ))
+                })
+            })),
+        })
+        .await;
+    assert!(result.is_err());
+    let (child_thread_id, model) = captured_rx.await.expect("child settings captured");
+    assert!(!model.is_empty());
+    timeout(Duration::from_secs(5), async {
+        while harness.manager.get_thread(child_thread_id).await.is_ok() {
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("failed spawn child should be removed");
+    assert!(
+        !harness
+            .manager
+            .captured_ops()
+            .into_iter()
+            .any(|(thread_id, op)| {
+                thread_id == child_thread_id && matches!(op, Op::TurnInput { .. })
+            })
+    );
+}
